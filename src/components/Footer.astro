---
import { getCollection } from "astro:content";

const tracksRaw = await getCollection("tracks");
const tracks = tracksRaw.sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="footer-brand">
    <span class="footer-name">צהיינש אדל־קרוט</span>
    <span class="footer-tagline">פסיכותרפיה · הדרכה קלינית והדרכת הורים · הרצאות והכשרות · ארגונים ואקדמיה</span>
  </div>
  <nav class="footer-nav" aria-label="ניווט תחתון">
    <a href={base}>דף הבית</a>
    {tracks.map((track) => (
      <a href={`${base}tracks/${track.data.slug}`}>{track.data.title}</a>
    ))}
    <a href={`${base}about`}>אודות</a>
    <a href={`${base}articles`}>מאמרים</a>
    <a href={`${base}#contact`}>צרו קשר</a>
  </nav>
</footer>

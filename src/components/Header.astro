---
// Nav reads the five tracks from the content collection, plus the two
// static stub routes and the contact anchor. No label is typed twice — see
// docs/specs/0001, "Canonical labels come from content, not markup".
import { getCollection } from "astro:content";

const tracksRaw = await getCollection("tracks");
const tracks = tracksRaw.sort((a, b) => a.data.order - b.data.order);

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
function isCurrent(href: string) {
  const clean = href.replace(/\/$/, "") || "/";
  return clean === currentPath;
}
---

<noscript>
  <style>
    /* Without JS the toggle has nothing to control, so the nav it would
       have hidden stays open instead of stuck closed. See docs/specs/0001
       story 30 and the manual checklist item "with JavaScript disabled,
       the nav is present and every link works". */
    .nav-toggle { display: none !important; }
    .main-nav { display: flex !important; }
  </style>
</noscript>

<header class="site-header">
  <a href="/" class="logo">
    <span class="logo-name">צהיינש אדל־קרוט</span>
    <span class="logo-tagline">פסיכותרפיה · הדרכה קלינית · ייעוץ</span>
  </a>

  <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="mainNav" aria-label="פתיחת תפריט ניווט">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
  </button>

  <nav id="mainNav" class="main-nav" aria-label="ניווט ראשי">
    <a href="/" class={isCurrent("/") ? "is-current" : undefined} aria-current={isCurrent("/") ? "page" : undefined}>דף הבית</a>
    {tracks.map((track) => {
      const href = `/tracks/${track.data.slug}`;
      return (
        <a href={href} class={isCurrent(href) ? "is-current" : undefined} aria-current={isCurrent(href) ? "page" : undefined}>
          {track.data.title}
        </a>
      );
    })}
    <a href="/about" class={isCurrent("/about") ? "is-current" : undefined} aria-current={isCurrent("/about") ? "page" : undefined}>אודות</a>
    <a href="/articles" class={isCurrent("/articles") ? "is-current" : undefined} aria-current={isCurrent("/articles") ? "page" : undefined}>מאמרים</a>
    <a href="/#contact" class="btn btn-header">יצירת קשר</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("navToggle");
  const nav = document.getElementById("mainNav");
  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    });
  }
</script>

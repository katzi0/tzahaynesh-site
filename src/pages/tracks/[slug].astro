---
// One route generates all five track stub pages from the content
// collection — no per-track file to keep in sync. See docs/specs/0001,
// "Five minimal track routes": these carry only the canonical title, the
// audience line and the scope line from brief §06. Real content is
// separate work, out of scope here.
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrackIcon from "../../components/TrackIcon.astro";
import lecturePhoto from "../../assets/photos/lecture.webp";

// Track-specific photographs, keyed by slug. Only tracks with a photo that
// actually shows that work get one — no stand-ins on the others.
const trackPhotos = {
  "lectures-training": {
    src: lecturePhoto,
    alt: "צהיינש אדל־קרוט מרצה מול קהל, ושקופית מוקרנת מאחוריה",
  },
} as const;

export async function getStaticPaths() {
  const tracks = await getCollection("tracks");
  return tracks.map((track) => ({
    params: { slug: track.data.slug },
    props: { track },
  }));
}

const { track } = Astro.props;
const { title, audience, format, scope, slug, sections, closing } = track.data;
const photo = trackPhotos[slug as keyof typeof trackPhotos];
---

<BaseLayout
  title={`${title} - צהיינש אדל־קרוט`}
  description={`${title}: ${audience}`}
>
  <article class="stub-page">
    <p class="eyebrow">מסלול</p>
    <h1>{title}</h1>

    {photo && (
      <figure class="track-photo">
        <Image src={photo.src} alt={photo.alt} widths={[680, 1360]} sizes="(max-width: 760px) 100vw, 680px" />
      </figure>
    )}

    {sections ? (
      <>
        {sections.map((section) => (
          <section class="track-section">
            <div class="track-section-head">
              <TrackIcon name={section.icon} />
              <h2>{section.heading}</h2>
            </div>
            {section.paragraphs.map((p) => <p>{p}</p>)}
          </section>
        ))}
        {closing && <p class="track-closing">{closing}</p>}
      </>
    ) : (
      <>
        <div class="field">
          <span class="label">קהל היעד</span>
          <p>{audience}</p>
        </div>
        <div class="field">
          <span class="label">מתכונת</span>
          <p>{format}</p>
        </div>
        {scope !== format && (
          <div class="field">
            <span class="label">היקף</span>
            <p>{scope}</p>
          </div>
        )}

        <p class="pending">
          זהו עמוד מסלול ראשוני. התוכן המלא - כולל הרחבה, דוגמאות ותהליך יצירת
          קשר ייעודי - ייבנה בהמשך.
        </p>
      </>
    )}
  </article>
</BaseLayout>

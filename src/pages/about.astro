---
// About — her biography, in her own words (supplied text, lightly
// proofread). Her portrait sits under the heading; the hero carries the
// theme's illustration instead.
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import aboutPortrait from "../assets/photos/portrait.jpg";

// ADR 0001: the joint venture is not named on this site. Her supplied text
// reads "…בהקמת וניהול של מכון 'דרך ענווה'", which both names it and
// credits her as sole founder. This is the one field to edit if that
// decision is reversed.
const interculturalOrigin = "מתוך הדרך הזאת צמחה גם העשייה שלי בתחום הבינתרבותי.";
---

<BaseLayout
  title="מי אני — צהיינש אדל־קרוט"
  description="צהיינש אדל־קרוט — פסיכותרפיסטית, דרמה־תרפיסטית, מדריכה ומרצה. יותר מעשרים שנה של טיפול, חינוך, הדרכה ועבודה בינתרבותית מתוך ענווה תרבותית."
>
  <article class="about-page">
    <p class="eyebrow">אודות</p>
    <h1>מי אני</h1>

    <div class="about-portrait">
      <Image
        src={aboutPortrait}
        alt="צהיינש אדל־קרוט, מחייכת, בטורבן פרחוני וקרדיגן אדום־אלמוגי"
        widths={[260, 520]}
        sizes="260px"
      />
    </div>

    <div class="about-prose">
      <p class="about-lead">
        אני צהיינש אדל־קרוט, פסיכותרפיסטית, דרמה־תרפיסטית, מדריכה ומרצה. כבר יותר
        מעשרים שנה אני פוגשת אנשים במרחבים של טיפול, חינוך, קהילה, הדרכה והכשרה
        מקצועית.
      </p>

      <p>
        היום אני מטפלת במתבגרים ובמבוגרים בקליניקה פרטית, מדריכה מטפלים וצוותים,
        מלמדת ומרצה באקדמיה ומפתחת ומנחה הרצאות, סדנאות והכשרות לאנשי מקצוע
        ולארגונים. תחום משמעותי נוסף בעשייה שלי הוא טיפול ועבודה בינתרבותית מתוך
        תפיסה של ענווה תרבותית.
      </p>

      <p class="about-turn">אבל הדרך שלי לא התחילה בחדר הטיפול.</p>

      <p>
        היא התחילה בחינוך, בתיאטרון, בהדרכה ובעבודה קהילתית ורב־תרבותית. עוד לפני
        שהיו לי המילים המקצועיות לתאר זאת, עניינו אותי המפגשים שבין אנשים: מה קורה
        כשאנחנו מגיעים מאותה משפחה אבל רואים את העולם אחרת? כשערכים, שפה, זהות,
        קהילה או תרבות פוגשים זה את זה? ומה מאפשר לנו להישאר סקרנים גם כשאנחנו לא
        מבינים מיד את מי שנמצא מולנו?
      </p>

      <p class="about-turn">משם הגעתי לעולם הטיפול.</p>

      <p>
        אני בעלת תואר שני בטיפול באמצעות אמנויות — דרמה־תרפיה, ובהמשך העמקתי
        בפסיכותרפיה קוגניטיבית־התנהגותית (CBT), ב־ACT ובמיינדפולנס, בטיפול בטראומה,
        בביופידבק, בהדרכת הורים בגישת אדלר ובתקשורת מקרבת (NVC). אני גם מדריכה
        רשומה ביה״ת.
      </p>

      <p>
        לאורך השנים גיליתי שאני לא מחפשת שיטה אחת שתסביר הכול. להפך. אני מאמינה
        שטיפול טוב מתחיל ביכולת לפגוש את האדם לפני שמנסים להתאים אותו לתיאוריה.
        לכן אני משלבת בין גישות וכלים שונים, ושואלת בכל פעם מחדש: מי האדם שנמצא
        מולי, מה הוא צריך עכשיו, ואיזו דרך יכולה להתאים לו?
      </p>

      <p class="about-turn">אותה שאלה מלווה אותי גם בהדרכה ובהוראה.</p>

      <p>
        כשאני מדריכה מטפלים או צוותים, חשוב לי לא רק לחשוב יחד על ״מה לעשות״, אלא
        לפתח יכולת להתבונן: במטופל, בקשר הטיפולי, בהקשר שבו הוא חי וגם בעצמנו
        כאנשי מקצוע. בהנחיה ובהוראה אני אוהבת לחבר בין תיאוריה לבין מה שקורה באמת
        בחדר הטיפול, ולהפוך רעיונות מורכבים לשאלות, להתנסויות ולכלים שאפשר לקחת
        לעבודה כבר למחרת בבוקר.
      </p>

      <p>
        {interculturalOrigin} עבורי, ענווה תרבותית אינה ״לדעת על תרבויות אחרות״,
        אלא עמדה מקצועית ואנושית: להיות מוכנה לדעת וגם לא לדעת; לזהות את ההנחות
        והערכים שאני מביאה איתי; להיות מודעת ליחסי כוח; ובעיקר להמשיך לשאול בסקרנות
        במקום למהר להסביר.
      </p>

      <p>
        כי תרבות מבחינתי היא הרבה מעבר למוצא או לשפה. היא נמצאת במשפחה שגדלנו בה,
        בקהילה, באמונה, במגדר, בדור, בערכים ובסיפורים שלמדנו לספר על עצמנו ועל
        העולם.
      </p>

      <p class="about-turn">
        אולי בגלל זה גם אחרי יותר מעשרים שנות עשייה, אני עדיין לומדת.
      </p>

      <p>
        מהמטופלים שלי, מהמודרכים, מהסטודנטים, מהצוותים שאני פוגשת, ממחקר ומגישות
        חדשות — וגם מהרגעים שבהם משהו שחשבתי שאני יודעת כבר לא מספיק.
      </p>

      <p>
        אני מאמינה שאין אמת אחת ואין דרך אחת נכונה לחיות, לטפל או להשתנות. יש בני
        אדם שונים, סיפורי חיים שונים ודרכים שונות להתמודד, לצמוח ולבנות חיים שיש
        בהם יותר בחירה, קשר ומשמעות.
      </p>

      <p class="about-close">
        אני מביאה למפגש את הידע והניסיון שצברתי לאורך השנים, ומשתדלת תמיד להשאיר
        מקום גם למה שעוד אינני יודעת.
      </p>
    </div>
  </article>
</BaseLayout>
